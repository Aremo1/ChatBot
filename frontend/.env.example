# Rhosam ChatBot Frontend Environment Variables

# These are baked into the production build at build time, so set them
# on the host (Vercel build env vars), not in this gitignored file.
#
# The backend URL must point at the deployed backend, and BOTH variables
# must use the same value so the Socket.IO client and the REST client
# connect to the same origin.
#
# VITE_API_URL=https://chat-api.rhosam.tech
# VITE_SOCKET_URL=https://chat-api.rhosam.tech

# Socket.io backend URL
VITE_SOCKET_URL=http://localhost:4000

# Backend API URL (for fetch calls)
VITE_API_URL=http://localhost:4000
