# Rhosam ChatBot Frontend Environment Variables

# These are baked into the production build at build time, so set them
# before running `npm run build` in frontend/ and then commit the resulting
# frontend/dist/ into the repo (or set them as build-time env vars on the
# host that builds the frontend).
#
# For the single-origin production deploy both variables are the same origin
# as the backend, so the Socket.IO client and the REST client connect to the
# same place without any cross-origin setup.
#
# Production (single origin — https://chatbot-saxe.onrender.com serves both):
# VITE_API_URL=https://chatbot-saxe.onrender.com
# VITE_SOCKET_URL=https://chatbot-saxe.onrender.com

# Local development defaults
VITE_SOCKET_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000
