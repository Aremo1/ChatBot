# Rhosam ChatBot Backend Environment Variables

# Server
PORT=4000
FRONTEND_URL=http://localhost:5173

# JWT Secret (change in production!)
JWT_SECRET=chatbot-dev-secret-change-in-production

# Google OAuth (https://console.cloud.google.com)
# Create OAuth 2.0 credentials in Google Cloud Console (Web application type).
# This app uses the Google OAuth token flow, not a server-side callback endpoint:
# the backend's /gmail/start-session builds a Google consent URL, the user
# completes consent in the browser, then the client sends the resulting idToken
# to /api/auth/google/register (first time) or /api/auth/google/login (returning).
#
# GOOGLE_REDIRECT_URI is passed into google-auth-library's OAuth2Client at boot
# and is used to build the consent URL, so it must be an authorized redirect URI
# in your Google Cloud Console OAuth client (Authorized redirect URIs).
#
# Local development:
# GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_REDIRECT_URI=http://localhost:4000
#
# Production (single origin — https://chatbot-saxe.onrender.com):
# GOOGLE_CLIENT_ID=<your Google OAuth client ID>
# GOOGLE_CLIENT_SECRET=<your Google OAuth client secret>
# GOOGLE_REDIRECT_URI=https://chatbot-saxe.onrender.com

# Google Cloud Console OAuth Scopes (for Gmail API)
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/calendar

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatbot
DB_USER=postgres
DB_PASSWORD=your_db_password

# Admin bootstrap — when set, this account (role: admin) is created or
# updated on every server start, so someone can add users and reset
# their passwords from the Settings → Admin panel.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password
ADMIN_NAME=Administrator

# Email delivery (password-reset OTPs, admin-generated passwords).
# Leave SMTP_HOST empty to log emails to the console instead — in dev mode
# the reset code is also returned to the client so the UI can work without a
# mailbox configured.
#
# Gmail example (use a Gmail app password, not your login password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_name@gmail.com
# SMTP_PASS=your_gmail_app_password
# EMAIL_FROM=your_name@gmail.com
#
# Other providers work too — just point SMTP_HOST/PORT/USER/PASS at them.
# Drop-in alternatives (uncomment one set and point SMTP_USER/SMTP_PASS at it):
#
# Resend:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=resend-xxxxxxxxxxxxxxxxxxxx@resend.dev
# SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=onboarding@resend.dev   (or your verified domain)
#
# SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=verified-sender@yourdomain.com
#
# Mailgun:
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=postmaster@<sandbox or domain>
# SMTP_PASS=<mailgun smtp password>
# EMAIL_FROM=verified-sender@yourdomain.com

# Note: Run `npm run setup-db` to create the database schema
