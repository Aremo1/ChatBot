# Rhosam ChatBot Backend Environment Variables

# Server
PORT=4000
FRONTEND_URL=http://localhost:5173

# JWT Secret (change in production!)
JWT_SECRET=chatbot-dev-secret-change-in-production

# Google OAuth (https://console.developers.google.com)
# Create OAuth 2.0 credentials in Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Google Cloud Console OAuth Scopes (for Gmail API)
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/calendar

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatbot
DB_USER=postgres
DB_PASSWORD=your_db_password

# Admin bootstrap — when set, this account (role: admin) is created or
# updated on every server start, so someone can add users and reset
# their passwords from the Settings → Admin panel.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password
ADMIN_NAME=Administrator

# Email delivery (password-reset OTPs, admin-generated passwords).
# Leave SMTP_HOST empty to log emails to the console instead — the
# reset code is then also returned to the client in dev mode.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=smtp_user
# SMTP_PASS=smtp_password
# EMAIL_FROM=no-reply@example.com

# Note: Run `npm run setup-db` to create the database schema
